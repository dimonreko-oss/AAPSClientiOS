# Xcode / Swift
build/
DerivedData/
*.xcuserstate
xcuserdata/
*.xcscmblueprint
*.moved-aside
.DS_Store

# xcodegen generates the project from project.yml — regenerate with `xcodegen generate`
*.xcodeproj

# IDE settings — per-developer, and .idea/ in particular carries device and run
# configuration that has no meaning in anyone else's checkout
.idea/
.vscode/
*.swp

# SwiftPM
.swiftpm/
.build/

# Bytecode from scripts/precheck.py, which runs on every push via the pre-push hook
__pycache__/
*.pyc

# Misc
*.log

# Local signing config (contains Apple Team ID) — copy from Config/Local.xcconfig.example
Config/Local.xcconfig
ExportOptions.plist

# Internal docs, not part of the public repo
docs/

# Internal Claude Code instructions, not for public repo
CLAUDE.md

# repomix output is a regenerable derived artifact, not source
repomix-output.json

# Local git worktrees used for isolated agent work
.worktrees/
